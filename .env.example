# Supabase Dashboard > Project Settings > API에서 복사합니다.
# EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 포함될 수 있으므로 anon/publishable key만 사용하세요.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# 절대 모바일 앱의 .env에 넣지 마세요.
# SUPABASE_SERVICE_ROLE_KEY는 Edge Function, 안전한 서버 또는 CI에서만 사용합니다.
